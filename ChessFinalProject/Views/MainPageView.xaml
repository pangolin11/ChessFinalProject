<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChessFinalProject.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="MainPageView">

    <Grid>
        <VerticalStackLayout>
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label
                    Margin="20"
                    FontSize="20"
                    Text="{Binding Name}"
                    TextColor="BlueViolet"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Label
                Margin="20"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Click here to start a new chess game"
                TextColor="CadetBlue"
                VerticalOptions="Center" />
            <Button
                Margin="20,20,20,20"
                Command="{Binding NavToChessCommand}"
                Text="Play now!"
                FontSize="20"
                VerticalOptions="Center" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>