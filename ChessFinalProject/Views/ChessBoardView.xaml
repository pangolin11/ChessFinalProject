<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChessFinalProject.Views.ChessBoardView"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="ChessBoardViewxaml">

    <Grid x:Name="OuterGrid">
        <CollectionView ItemsSource="{Binding Board}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid HeightRequest="48" WidthRequest="48">
                        <!-- background square without a converter -->
                        <BoxView HorizontalOptions="Fill" VerticalOptions="Fill">
                            <BoxView.Style>
                                <Style TargetType="BoxView">
                                    <!-- default dark color -->
                                    <Setter Property="Color" Value="SaddleBrown" />
                                    <Style.Triggers>
                                        <!-- when IsWhite is true, set a light color -->
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsWhite}" Value="True">
                                            <Setter Property="Color" Value="Beige" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </BoxView.Style>
                        </BoxView>

                        <!-- piece image (empty -> no image shown if you set Image to null/empty) -->
                        <Image Source="{Binding Image}"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

                        <!-- tap forwards the square name to the ViewModel command -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.SquareTappedCommand, Source={x:Reference RootPage}}"
                                CommandParameter="{Binding Name}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>