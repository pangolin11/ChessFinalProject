<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChessFinalProject.Views.ChessBoardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="RootPage"
    Title="ChessBoardViewxaml">
    <Grid x:Name="OuterGrid" Margin="0,90,0,0">

        <CollectionView
            FlowDirection="LeftToRight"
            ItemsSource="{Binding Board}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid HeightRequest="48" WidthRequest="48">

                        <!--  background square without a converter  -->
                        <BoxView HorizontalOptions="Fill" VerticalOptions="Fill">
                            <BoxView.Style>
                                <Style TargetType="BoxView">
                                    <!--  default dark color  -->
                                    <Setter Property="Color" Value="SaddleBrown" />
                                    <Style.Triggers>
                                        <!--  when IsWhite is true, set a light color  -->
                                        <DataTrigger
                                            Binding="{Binding IsWhite}"
                                            TargetType="BoxView"
                                            Value="True">
                                            <Setter Property="Color" Value="Beige" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </BoxView.Style>
                        </BoxView>

                        <!--  piece image (empty -> no image shown if you set Image to null/empty)  -->
                        <Image
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            Source="{Binding Image}"
                            VerticalOptions="Center">
                            <Image.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsYellow}"
                                    TargetType="Image"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="Yellow" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>

                        <!--  tap forwards the square name to the ViewModel command  -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.SquareTappedCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding Name}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label
            Margin="300,300,0,0"
            FontSize="16"
            HorizontalOptions="Center"
            Text="{Binding EnemyTime}"
            TextColor="Red"
            VerticalOptions="Center" />

        <Grid
            HorizontalOptions="Fill"
            IsVisible="{Binding Busy}"
            VerticalOptions="Fill">

            <BoxView
                BackgroundColor="LightBlue"
                HorizontalOptions="Fill"
                Opacity="0.7"
                VerticalOptions="Fill" />

            <ActivityIndicator
                IsRunning="True"
                WidthRequest="100"
                Color="Beige" />
            <Label
                Margin="0,400,0,0"
                FontSize="16"
                HorizontalOptions="Center"
                Text="{Binding LoadingMessage}"
                TextColor="White" />
        </Grid>
        <Label
            Margin="0,300,300,0"
            FontSize="16"
            HorizontalOptions="Center"
            Text="{Binding FriendlyTime}"
            TextColor="Yellow"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>