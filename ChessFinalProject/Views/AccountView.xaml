<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChessFinalProject.Views.AccountView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ChessFinalProject.Model"
    xmlns:views="clr-namespace:ChessFinalProject.ViewModels"
    Title="AccountView"
    x:DataType="views:AccountViewModel">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#C6426E" />
            <GradientStop Offset="1.0" Color="#642B73" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!--<Grid ColumnDefinitions="*,8*,*" RowDefinitions="1.5*,4*,*">-->
        <Grid ColumnDefinitions="0.1*,8*,0.1*" RowDefinitions=".8*,2.6*,5.5*,*">
            <!--  Delete ImageButton  -->
            <HorizontalStackLayout
                Grid.ColumnSpan="3"
                Margin="0,10,20,0"
                HorizontalOptions="End"
                IsVisible="{Binding IsDeleteButtonVisible}"
                VerticalOptions="Center">
                <Button
                    Background="Transparent"
                    Command="{Binding DeleteCommand}"
                    FontFamily="MaterialIcons"
                    FontSize="40"
                    HeightRequest="60"
                    Text="{Binding DeleteIcon}"
                    TextColor="Wheat" />

            </HorizontalStackLayout>
            <!--  User Fields  -->
            <VerticalStackLayout
                Grid.Row="2"
                Grid.Column="1"
                Margin="20,-80,20,0">

                <!--  שדה שם פרטי  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    Stroke="#ccc"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">

                    <Entry
                        FontSize="15"
                        Placeholder="First Name"
                        Text="{Binding FirstName}"
                        TextColor="Wheat" />

                </Border>
                <!--  שדה שם משפחה  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    Stroke="#ccc"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">

                    <Entry
                        FontSize="15"
                        Placeholder="Last Name"
                        Text="{Binding LastName}"
                        TextColor="Wheat" />

                </Border>
                <!--  שדה דואל  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    Stroke="#ccc"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">

                    <Entry
                        FontSize="15"
                        IsEnabled="False"
                        Keyboard="Email"
                        Placeholder="Email"
                        Text="{Binding UserEmail}"
                        TextColor="Gray" />

                </Border>
                <!--  שדה מספר נייד  -->
                <Border
                    Margin="0,0,0,10"
                    Padding="10"
                    HeightRequest="60"
                    Stroke="#ccc"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="1">

                    <Entry
                        FontSize="15"
                        Keyboard="Telephone"
                        Placeholder="Mobile"
                        Text="{Binding UserMobile}"
                        TextColor="Wheat" />

                </Border>


                <VerticalStackLayout Grid.Row="4" />

                <!--  Error Message  -->
                <Label
                    Margin="30,0,0,10"
                    IsVisible="{Binding ErrorMessageIsVisible}"
                    Text="{Binding ErrorMessage}"
                    TextColor="#ff4dd2" />

                <!--  כפתור עדכון  -->
                <Button
                    Margin="0,10,0,0"
                    Command="{Binding UpdateCommand}"
                    CornerRadius="8"
                    FontSize="18"
                    HeightRequest="50"
                    Text="Update" />

            </VerticalStackLayout>
        </Grid>

        <!--  מסך טעינה  -->
        <Grid
            HorizontalOptions="Fill"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Fill">

            <BoxView
                BackgroundColor="LightBlue"
                HorizontalOptions="Fill"
                Opacity="0.7"
                VerticalOptions="Fill" />

            <ActivityIndicator
                IsRunning="True"
                WidthRequest="100"
                Color="Beige" />
        </Grid>
    </Grid>

</ContentPage>