<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ChessFinalProject.Views.AdminView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AdminView">
    
    <VerticalStackLayout>
        <Label
            Margin="20"
            HorizontalOptions="Center"
            FontSize="25"
            TextColor="PaleVioletRed"
            Text="Welcome to Admin Page"
            VerticalOptions="Center" />

        <HorizontalStackLayout Margin="20">

            <Label
                Margin="20"
                HorizontalOptions="Center"
                FontSize="20"
                Text="Debug Mode"
                VerticalOptions="Center" />
            <Switch
                HorizontalOptions="Center"
                IsToggled="{Binding IsDebugMode}"
                VerticalOptions="Center" />

        </HorizontalStackLayout>

        <Button   
            Margin="20,0,20,0"
            BackgroundColor="LightBlue"
            Command="{Binding NavigateToUsersListViewCommand}"
            FontSize="20"          
            TextColor="DarkBlue"
            Text="View Users" />

    </VerticalStackLayout>
</ContentPage>